{
  "name": "campus-manual",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "bike-lanes:generate": "node scripts/generate-bike-lanes.mjs",
    "bike-lanes:check": "node scripts/generate-bike-lanes.mjs --check",
    "map:bundle": "node scripts/build-map-bundle.mjs",
    "prestart": "npm run fonts:fetch && npm run map:bundle",
    "start": "expo start",
    "pretypecheck": "npm run map:bundle",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run fonts:fetch && npm run map:bundle",
    "build": "expo export --platform ios --platform android",
    "pretest": "npm run bike-lanes:check && npm run map:bundle",
    "test": "tsc -p tsconfig.tests.json && node --test tests/*.cjs",
    "fonts:fetch": "python3 scripts/fetch-fonts.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-font": "57.0.1",
    "expo-image-picker": "57.0.14",
    "expo-location": "57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "maplibre-gl": "6.11.2",
    "typescript": "~5.9.2"
  }
}
