{
  "expo": {
    "name": "Campus Hazards",
    "slug": "campus-manual",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": []
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Hazards uses your location once, only when you tap \"Use my location\", to place a report pin or route endpoint.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
