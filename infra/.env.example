# Copy to .env and replace placeholders; never commit actual credentials.
PRODUCT_DB_PASSWORD=replace-with-local-development-password
AUTOMATION_PUBLISH_KEY=replace-with-local-development-publisher-key
# DATABASE_URL enables PostGIS persistence in the API (Compose sets it for the api container). VALHALLA_URL is planned (C4).
DATABASE_URL=postgresql://product:replace-with-local-development-password@localhost:5432/product
VALHALLA_URL=http://localhost:8002
EXPO_PUBLIC_API_URL=http://localhost:8000
# Optional automation starts separately; never give it the product database credential.
AUTOMATION_DATABASE_URL=postgresql://observations:replace-with-separate-password@localhost:5432/observations
PRODUCT_API_URL=http://localhost:8000
EXPO_PUBLIC_AUTOMATION_API_URL=http://localhost:8001
DEMO_MODE=0
