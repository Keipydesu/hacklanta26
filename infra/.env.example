# Copy to infra/.env and replace every placeholder; never commit real credentials.
# Scripts refuse to run against a public host while a value still starts with "replace-".

# --- Manual stack (always) ---
PRODUCT_DB_PASSWORD=replace-with-local-development-password
# Server-side only: the product API and the automation worker. Never an Expo public variable.
AUTOMATION_PUBLISH_KEY=replace-with-local-development-publisher-key
# 0.0.0.0 lets a phone on the LAN reach a development machine. Use 127.0.0.1 on a public host.
API_BIND=0.0.0.0
API_PORT=8000

# --- Routing (--profile routing) ---
# Leave empty for the fixed example routes. With the routing profile: http://valhalla:8002
VALHALLA_URL=
# The engine Lane C recorded its fixtures with. Confirm the tag and pin a digest before relying on it.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla:3.9.1

# --- HTTPS (--profile https) ---
# A hostname whose DNS points at this host, with ports 80 and 443 reachable.
PRODUCT_HOSTNAME=localhost
CADDY_IMAGE=caddy:2.10.0

# --- Optional automation (--profile automation) ---
# A different password from the product one. Empty means the observation database is not created.
OBSERVATIONS_DB_PASSWORD=
# Where the worker publishes. The Compose network name works on one host; use the public HTTPS URL otherwise.
PRODUCT_API_URL=http://api:8000
OBSERVATION_HOSTNAME=observations.localhost
AUTOMATION_BIND=0.0.0.0
AUTOMATION_PORT=8001
DEMO_MODE=0

# --- Used by the apps and tools, not by Compose ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_AUTOMATION_API_URL=http://localhost:8001
